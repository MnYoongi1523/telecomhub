            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"administrador\",\n  \"password\": \"Admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200 + token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.mensaje).to.match(/satisfactoria/i);",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  pm.environment.set('token', j.data.token);",
                  "});"
                ]
              }
            }
          ]
        },
